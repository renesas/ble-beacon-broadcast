build/
build-*/
.cache/

# Meson subproject sources fetched via wrap files (re-downloaded on setup)
subprojects/*/
*.o
*.elf
*.map
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake

# e2 studio build/debug artifacts
Debug/
Release/
*.log
.metadata/

# RASC "Generate Project Content" output. All of this is reproduced from
# configuration.xml by any developer, so it is not tracked.
# NOTE: script/fsp.ld IS tracked - it is user-editable and holds the
# board's memory layout. fsp_gen.ld and memory_regions.ld are the
# generated fragments that fsp.ld INCLUDEs.
**/ra/
**/ra_cfg/
**/ra_gen/
**/fsp_gen.ld
**/memory_regions.ld
**/bsp_linker_info.h
**/buildinfo.json

# Compilation database - regenerated by CMake and by e2 studio's
# compilationDatabaseBuilder. Contains absolute paths, so it can never
# be shared between machines.
**/compile_commands.json

# clangd config emitted by the Renesas VS Code extension
**/.clangd

# FSP Configurator UI state - remembers which tab was last open
# (active_page=SWPConfigurator / PinConfiguration / ...). Per-developer,
# no build impact, changes every time the configurator is opened.
**/.settings/com.renesas.cdt.ddsc.settingseditor.prefs

# CDT language settings - caches the GCC built-in specs detector output,
# including absolute toolchain paths and an env-hash. Machine-local;
# Eclipse regenerates it on first build.
**/.settings/language.settings.xml

# Recreated by e2 studio on project import / first build. The pack CRC
# blob regenerates byte-identically from configuration.xml + installed
# packs, so tracking it only adds churn.
**/.settings/com.renesas.cdt.ddsc.packs.componentfiles.prefs
**/.settings/org.eclipse.cdt.managedbuilder.core.prefs
